{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for Space Truck. Dependabot keeps npm updates for now; Renovate focuses on GitHub Actions and pinned action SHAs.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":timezone(America/Sao_Paulo)"
  ],
  "enabledManagers": ["github-actions"],
  "dependencyDashboardTitle": "Dependency Dashboard - Renovate",
  "labels": ["dependencies", "github-actions", "automated"],
  "schedule": ["before 9am on monday"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "rangeStrategy": "pin",
  "pinDigests": true,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": false,
  "automerge": false,
  "packageRules": [
    {
      "description": "Group routine GitHub Actions updates together.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions maintenance",
      "groupSlug": "github-actions-maintenance"
    },
    {
      "description": "Keep major GitHub Actions updates separate for safer review.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github-actions major updates",
      "groupSlug": "github-actions-major"
    }
  ],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "storybook-static/**"
  ]
}
