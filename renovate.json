{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Configuração do Renovate para o Space Truck. O Dependabot mantém atualizações npm por enquanto; o Renovate foca em GitHub Actions e Actions pinadas por SHA.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":timezone(America/Sao_Paulo)"
  ],
  "enabledManagers": ["github-actions"],
  "dependencyDashboardTitle": "Painel de dependências - Renovate",
  "labels": ["dependencies", "github-actions", "automated"],
  "schedule": ["before 9am on monday"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "rangeStrategy": "pin",
  "pinDigests": true,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": false,
  "automerge": false,
  "packageRules": [
    {
      "description": "Agrupa atualizações rotineiras de GitHub Actions.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions maintenance",
      "groupSlug": "github-actions-maintenance"
    },
    {
      "description": "Mantém atualizações major de GitHub Actions separadas para revisão mais segura.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github-actions major updates",
      "groupSlug": "github-actions-major"
    }
  ],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "storybook-static/**"
  ]
}
